# Caddy gateway for the FunASR deployment.
#
# Caddy listens on :80 (the Cloudflare Tunnel origin). It:
#   * serves the PWA static frontend (pwa/) at the site root, and
#   * reverse-proxies the FunASR HTTP API paths to the internal ASR server
#     (running on port 8080).
#
# NOTE: the root is a RELATIVE path (./pwa) so it does not depend on the
# {$GITHUB_WORKSPACE} env var surviving sudo/daemonization. The workflow
# launches Caddy from the repository root (cd $GITHUB_WORKSPACE first), and
# the daemonized process keeps that working directory.

{
    admin off
    auto_https off
}

:80 {
    encode gzip

    # ---- FunASR API paths are forwarded to the internal ASR server ----
    @funasr path /health /asr /recognize /v1/* /docs /openapi.json /redoc
    handle @funasr {
        reverse_proxy 127.0.0.1:8080
    }

    # ---- Everything else: serve the PWA (SPA fallback to index.html) ----
    handle {
        root * ./pwa
        try_files {path} /index.html
        file_server
    }
}